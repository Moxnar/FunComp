# Build output (CMake build trees)
/build*/

# Downloaded tools and data: fetch again rather than version them
/books/
/tools/fastchess/
/tools/cutechess/
/tools/opponents/

# Engine binaries: each is rebuilt from the commit that produced it
/engines/

# Match output is large (PGNs, logs, fastchess state); the results table
# is the record worth keeping
/matches/*
!/matches/results.md

# Generated label data
*.csv
*.csv.params

# Backup archives
*.7z
*.zip

# SPSA parameter files are inputs, not generated data
!/tools/spsa/*.csv
/release/
